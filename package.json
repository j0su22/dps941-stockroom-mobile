    "@react-navigation/bottom-tabs": "^7.3.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "expo": "~55.0.32",
    "expo-camera": "~55.0.23",
    "expo-constants": "~55.0.0",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.0",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-secure-store": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "firebase": "^12.6.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
