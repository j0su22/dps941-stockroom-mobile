{
  "name": "dps941-stockroom-mobile",
  "version": "2.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web",
    "check": "npm run typecheck && npm test",
    "test:firebase": "npm --prefix tools run build && firebase emulators:exec --project demo-stockroom-tests --only firestore \"node tests/firebase-emulator.cjs\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
